+// ===========================================================================
+// FeedSim.jsx — the Simulated Social Media Feed (SSMF) module
+// ---------------------------------------------------------------------------
+// One post at a time. For each post we record: the decision, the stated
+// reason, dwell time in milliseconds, whether the participant opened the
+// "check it" affordance, the assigned social-proof level, and the arm.
+// Every post is fictional — see lib/scenarios.js.
+// ===========================================================================
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import { buildFeedTrials, DECISIONS, REASON_CODES, PREBUNK_CONTENT } from "../lib/scenarios.js";
+
+function fmt(n) {
+  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
+  return String(n);
+}
+
+function Prebunk({ onDone }) {
+  return (
+    <div className="screen">
+      <h2 className="screen-title">🛡️ {PREBUNK_CONTENT.title}</h2>
+      <p className="screen-note">
+        Take thirty seconds with these. You'll see a short feed next.
+      </p>
+      <div className="card-grid">
+        {PREBUNK_CONTENT.points.map((p) => (
+          <div className="info-card" key={p.name}>
+            <div className="info-icon">{p.icon}</div>
+            <h3>{p.name}</h3>
+            <p>{p.text}</p>
+          </div>
+        ))}
+      </div>
+      <div className="screen-actions">
+        <button className="btn btn-primary" onClick={onDone}>I'm ready →</button>
+      </div>
+    </div>
+  );
+}
+
+function VerifyPanel({ onClose }) {
+  return (
+    <div className="verify-panel">
+      <h4>🔍 What checking actually looks like</h4>
+      <ul>
+        <li>Is the person registered with the regulator, or just confident?</li>
+        <li>Are they being paid to say this? Look for a disclosure.</li>
+        <li>Does a second, independent source say the same thing?</li>
+        <li>What is the downside case — and can you afford it?</li>
+      </ul>
+      <button className="btn btn-ghost btn-sm" onClick={onClose}>Close</button>
+    </div>
+  );
+}
+
+export default function FeedSim({ session, arm, onComplete, onBack }) {
+  const posts = useMemo(() => buildFeedTrials(session.participantId), [session.participantId]);
+  const [showPrebunk, setShowPrebunk] = useState(!!arm.showPrebunk);
+  const [idx, setIdx] = useState(0);
+  const [trials, setTrials] = useState([]);
+  const [decision, setDecision] = useState(null);
+  const [reason, setReason] = useState(null);
+  const [openedVerify, setOpenedVerify] = useState(false);
+  const [pauseLeft, setPauseLeft] = useState(0);
+  const shownAt = useRef(Date.now());
+
+  const post = posts[idx];
+  const isLast = idx === posts.length - 1;
+
+  useEffect(() => {
+    shownAt.current = Date.now();
+    setDecision(null);
+    setReason(null);
+    setOpenedVerify(false);
+    setPauseLeft(0);
+  }, [idx]);
+
+  // Mindful-pause arm: a forced delay between choosing and confirming.
+  useEffect(() => {
+    if (!arm.showPause || !decision) return undefined;
+    setPauseLeft(arm.pauseSeconds);
+    const t = setInterval(() => {
+      setPauseLeft((s) => {
+        if (s <= 1) {
+          clearInterval(t);
+          return 0;
+        }
+        return s - 1;
+      });
+    }, 1000);
+    return () => clearInterval(t);
+  }, [decision, arm]);
+
+  if (showPrebunk) return <Prebunk onDone={() => setShowPrebunk(false)} />;
+
+  const canConfirm = decision && reason && pauseLeft === 0;
+
+  const confirm = () => {
+    const trial = {
+      postId: post.id,
+      targetBias: post.targetBias,
+      tag: post.tag,
+      socialProof: post.socialProof,
+      likes: post.metrics.likes,
+      arm: arm.id,
+      decision,
+      reason,
+      reasonMaps: REASON_CODES[reason]?.maps || null,
+      openedVerify,
+      dwellMs: Date.now() - shownAt.current,
+      order: idx,
+    };
+    const next = [...trials, trial];
+    setTrials(next);
+    if (isLast) onComplete(next);
+    else setIdx((n) => n + 1);
+  };
+
+  return (
+    <div className="screen screen-feed">
+      <h2 className="screen-title">📰 Your feed</h2>
+      <p className="screen-note">
+        Imagine these appeared in your feed today. React the way you actually would.
+        <strong> Post {idx + 1} of {posts.length}.</strong>
+      </p>
+
+      <article className={"sim-post tone-" + post.tag}>
+        <header className="sim-head">
+          <div className="sim-avatar">{post.avatar}</div>
+          <div>
+            <div className="sim-handle">
+              {post.handle} {post.verified && <span className="tick" title="Verified">✔</span>}
+            </div>
+            <div className="sim-kind">{post.kind}{post.metrics.trending && <span className="trend-chip">🔥 Trending</span>}</div>
+          </div>
+        </header>
+
+        <p className="sim-body">{post.body}</p>
+
+        {arm.showDisclosure && post.tag !== "calm" && (
+          <div className="sim-disclosure">
+            ⚠️ Content like this may be a paid promotion. Returns shown are not guaranteed and you can lose money.
+          </div>
+        )}
+
+        <footer className="sim-metrics">
+          <span>❤️ {fmt(post.metrics.likes)}</span>
+          <span>💬 {fmt(post.metrics.comments)}</span>
+          <button className="link-btn" onClick={() => setOpenedVerify((v) => !v)}>
+            {openedVerify ? "Hide" : "🔍 How would I check this?"}
+          </button>
+        </footer>
+        {openedVerify && <VerifyPanel onClose={() => setOpenedVerify(false)} />}
+      </article>
+
+      <div className="feed-q">
+        <h4>What would you do?</h4>
+        <div className="chip-row">
+          {DECISIONS.map((d) => (
+            <button
+              key={d.id}
+              className={"chip chip-lg" + (decision === d.id ? " chip-on" : "")}
+              onClick={() => setDecision(d.id)}
+            >
+              {d.icon} {d.label}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      {decision && (
+        <div className="feed-q feed-q-in">
+          <h4>What's driving that?</h4>
+          <div className="chip-row chip-col">
+            {Object.entries(REASON_CODES).map(([k, v]) => (
+              <button
+                key={k}
+                className={"chip" + (reason === k ? " chip-on" : "")}
+                onClick={() => setReason(k)}
+              >
+                {v.label}
+              </button>
+            ))}
+          </div>
+        </div>
+      )}
+
+      {arm.showPause && decision && pauseLeft > 0 && (
+        <div className="pause-box">
+          <div className="pause-ring">{pauseLeft}</div>
+          <p>
+            Take a breath. Notice what you are feeling right now — curiosity, urgency, doubt.
+            You can confirm in {pauseLeft} second{pauseLeft === 1 ? "" : "s"}.
+          </p>
+        </div>
+      )}
+
+      <div className="screen-actions">
+        {idx === 0 ? (
+          <button className="btn btn-ghost" onClick={onBack}>Back</button>
+        ) : (
+          <span className="answered-count">{idx} of {posts.length} done</span>
+        )}
+        <button className="btn btn-primary" disabled={!canConfirm} onClick={confirm}>
+          {isLast ? "Finish the feed →" : "Next post →"}
+        </button>
+      </div>
+    </div>
+  );
+}
