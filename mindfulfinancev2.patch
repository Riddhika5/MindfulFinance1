     "//build": "------- used when deploying to the internet -------",
-    "build": "npm --prefix client install && npm --prefix client run build",
+    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
     "start": "node server/index.js"
   },
   "dependencies": {
