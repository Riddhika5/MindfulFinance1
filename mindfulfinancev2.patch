   "type": "module",
   "scripts": {
     "//": "------- main commands you will use -------",
-    "setup": "npm install && npm --prefix client install",
+    "setup": "npm install && npm --prefix client install --include=dev",
     "dev": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run client\"",
     "server": "node server/index.js",
