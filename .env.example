# Copy this file to ".env" ONLY if you want to use MongoDB locally.
# You do NOT need this to run the app on your PC — without it, the app
# automatically saves data to local files (server/data/*.json).
#
# For the PUBLIC website, you set these as Environment Variables on the host
# (e.g. Render), NOT in a file.

# Your MongoDB Atlas connection string (from Atlas -> Connect -> Drivers):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: the database name to use (defaults to "mindfulmoney"):
# MONGODB_DB=mindfulmoney
